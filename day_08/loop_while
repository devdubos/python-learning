def task_number():
    n = 2
    m = 4
    while n <= m:
        print(n ** 2, end= " ")
        n += 1

def task_whilebook():
    x = float(input())
    N = 2
    while N <= 10:
        c = x * N
        print(round(c, 1), end=" ")
        N = N + 1

def task_fractions():
    x = int(input())
    N = 1
    S = 0
    while N <= x:
        S = S + 1/N
        N += 1
    print(round(S, 3))


def task_bank():
    x = int(input())
    y = float(input())
    age = 0
    while x < y:
        x = x + (x*0.1)
        age = age + 1
    print(age)


def task_summ():
    x = int(input())
    S = 0
    while x > 0:
        numb = x % 10
        S = numb + S
        x = x // 10
    print(S)

